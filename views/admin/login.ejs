<%- include('_head', { title: 'Đăng nhập quản trị, Bunnie Studio' }) %>
<body class="admin admin-login">
<main class="login-box">
  <img src="/brand/logo.svg" alt="Bunnie Studio" width="96" height="89">
  <h1>Quản trị sample</h1>
  <% if (locked) { %>
    <p class="a-msg is-err">Trang quản trị chưa được bật. Cần đặt biến môi trường <code>ADMIN_PASSWORD</code> trên hosting.</p>
  <% } else { %>
    <form method="post" action="/admin/login" class="a-form">
      <label class="field"><span>Mật khẩu</span><input type="password" name="password" autocomplete="current-password" required autofocus></label>
      <% if (error) { %><p class="a-msg is-err" role="alert"><%= error %></p><% } %>
      <button class="btn btn-primary btn-block" type="submit">Đăng nhập</button>
    </form>
  <% } %>
  <a class="link-sm" href="/">Về trang chủ</a>
</main>
</body></html>
