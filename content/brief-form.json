{
  "_note": "Form đăng ký tư vấn ban đầu. Brief chi tiết điền qua sheet sau khi cọc (Quy trình bước 3).",
  "fields": [
    { "id": "name", "label": "Tên / nickname", "type": "text", "required": true },
    { "id": "phone", "label": "Số điện thoại", "type": "tel", "required": true },
    { "id": "clientType", "label": "Bạn là", "type": "select", "options": ["Fan cá nhân", "Fanclub / fanpage", "Ekip idol", "Khác"] },
    { "id": "project", "label": "Idol / dự án / sự kiện", "type": "text" },
    { "id": "products", "label": "Sản phẩm cần làm", "type": "multiselect", "required": true, "source": "pricing.groups" },
    { "id": "finalDate", "label": "Ngày cần final", "type": "date", "required": true },
    { "id": "budget", "label": "Ngân sách dự kiến", "type": "text" },
